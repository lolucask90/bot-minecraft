# Copie este arquivo com o nome .env e preencha com os seus dados.

# ⚠️ O arquivo .env guarda o SEGREDO do seu bot.
# Nunca mostre para ninguém, nunca mande print dele e nunca envie para o GitHub.

# Token do bot: Discord Developer Portal → seu app → Bot → Reset Token
DISCORD_TOKEN=cole_seu_token_aqui

# (Opcional) Servidor de Minecraft usado quando alguém digita /status sem IP
SERVIDOR_MINECRAFT_PADRAO=

# (Opcional) ID do canal de boas-vindas.
# Se ficar vazio, o bot usa o "canal de mensagens do sistema" do servidor do Discord.
CANAL_BOAS_VINDAS_ID=
